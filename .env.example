# Copy this file to .env and fill in secrets. .env is git-ignored and never committed.

ENVIRONMENT=development
DEBUG=true

# Used when running the backend directly on the host (localhost).
# docker-compose overrides these with the internal service names (db, redis).
DATABASE_URL=postgresql+asyncpg://construction:construction@localhost:5432/construction_ai
REDIS_URL=redis://localhost:6379/0

# LLM provider (provider-agnostic; Gemini free tier by default via its OpenAI-compatible endpoint).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=

# Local multilingual embeddings via fastembed (no key, runs on CPU).
# "hash" = deterministic dependency-free vectors (tests/dev); "local" = real fastembed model.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024

# Auth (replace before any non-local deployment).
JWT_SECRET=dev-secret-change-me-in-production-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
# The token is delivered as an httpOnly cookie. Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false
