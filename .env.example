# Copy this file to .env and fill in secrets. .env is git-ignored and never committed.

ENVIRONMENT=development
DEBUG=true

# Used when running the backend directly on the host (localhost).
# docker-compose overrides these with the internal service names (db, redis).
DATABASE_URL=postgresql+asyncpg://construction:construction@localhost:5432/construction_ai
REDIS_URL=redis://localhost:6379/0

# LLM engine. The platform depends only on an OpenAI-compatible chat endpoint, so the model is a
# swappable component. Keep exactly ONE LLM_PROVIDER line uncommented; the base URL and model
# default to that provider's preset when left blank, and explicit values override the preset.
#   local  - open-weights model via Ollama on this machine (free, private, offline). No key needed.
#   groq   - hosted free tier, OpenAI-compatible (set LLM_API_KEY to a Groq key).
#   gemini - Google AI Studio free tier (set LLM_API_KEY to a Gemini key).
#   mock   - deterministic, no network; always used by the test suite.
LLM_PROVIDER=gemini
# LLM_PROVIDER=local
# LLM_PROVIDER=groq
# LLM_PROVIDER=mock

# API key for the active cloud provider. Ignored by local and mock.
LLM_API_KEY=

# Optional overrides — leave blank to use the selected provider's preset.
# For local, the preset model is qwen2.5:7b-instruct.
LLM_MODEL=
LLM_BASE_URL=

# Local multilingual embeddings via fastembed (no key, runs on CPU).
# "hash" = deterministic dependency-free vectors (tests/dev); "local" = real fastembed model.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024

# Auth (replace before any non-local deployment).
JWT_SECRET=dev-secret-change-me-in-production-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
# The token is delivered as an httpOnly cookie. Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false
